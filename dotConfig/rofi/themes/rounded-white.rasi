    bg1:    rgba(0,0,0,0.5);
    bg2:    #dc7786;
    bg3:    #feebec;

    fg0:    #a1b1e3;
    fg1:    #dc7786;
    fg2:    #dc7786;
    fg3:    #dc7786;

}

